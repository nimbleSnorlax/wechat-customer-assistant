+                .Where(window => window.Hwnd != preferred &&
+                    !window.Class.Contains("WxTrayIcon", StringComparison.OrdinalIgnoreCase))
+                .Select(window => Check(window.Hwnd))
+                .FirstOrDefault(window => window != null);
