+        /// <summary>Finds a verified signed-in main window without changing its visibility or focus.</summary>
+        public static AutomationElement FindSignedInWindow(UIA3Automation automation, int processId, IntPtr preferred)
+        {
+            AutomationElement Check(IntPtr handle)
+            {
+                if (handle == IntPtr.Zero || !IsWindow(handle))
+                    return null;
+                try
+                {
+                    var window = automation.FromHandle(handle);
+                    if (window?.Properties.ProcessId.ValueOrDefault != processId)
+                        return null;
+                    var navigation = FindNavigationBar(window);
+                    if (navigation?.Properties.AutomationId.ValueOrDefault == "MainView.main_tabbar" ||
+                        FindChatsTab(navigation) != null)
+                        return window;
+                }
+                catch (COMException) { }
+                catch (InvalidOperationException) { }
+                return null;
+            }
+
